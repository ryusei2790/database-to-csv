# .env.example
# 実際に使う場合はこのファイルを .env にコピーして値を書き換えてください
# docker-compose.yml の environment で上書きされるため、
# Docker 実行時はこのファイルは不要です

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sampledb
# 省略時は information_schema / pg_% を除く全ユーザースキーマを対象にします
# DB_SCHEMA=public,app

# 各テーブルから取得する最大行数
LIMIT=1000
